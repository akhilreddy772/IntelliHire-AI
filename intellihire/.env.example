# ============================================================
# IntelliHire AI — Environment Configuration
# Copy this file to .env  or  export each variable in your shell.
# ============================================================

SECRET_KEY=intellihire-production-secret-key-2026

# ────────────────────────────────────────────────────────────
# DATABASE CONFIGURATION
# IntelliHire tries databases in this order:
#   1. MySQL  (if MYSQL_HOST or MYSQL_URL is set)
#   2. PostgreSQL  (if PGHOST or DATABASE_URL is set)
#   3. SQLite  (always-available fallback → data/intellihire.db)
# ────────────────────────────────────────────────────────────

# ── Option A: MySQL (MySQL Workbench / WAMP / XAMPP / RDS) ──
# Uncomment and fill in your MySQL credentials.
# Install driver:  pip install pymysql
#
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=yourMySQLpassword
# MYSQL_DATABASE=intellihire
#
# Or use a single URL:
# MYSQL_URL=mysql+pymysql://root:yourMySQLpassword@localhost:3306/intellihire

# ── Option B: PostgreSQL ─────────────────────────────────────
# Install driver:  pip install psycopg2-binary
#
# DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/intellihire
#
# Or use individual parameters:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=yourpassword
# PGDATABASE=intellihire

# ── Option C: SQLite (default — no extra config needed) ──────
# Just leave the blocks above commented out.
# Database file will be created at:  intellihire/data/intellihire.db

# ────────────────────────────────────────────────────────────
# OPTIONAL AI INTEGRATION
# ────────────────────────────────────────────────────────────
# Anthropic Claude API Key (optional — built-in heuristics run if omitted)
# ANTHROPIC_API_KEY=sk-ant-api03-...
